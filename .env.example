# AWS/S3 Configuration (Floci)
# Floci accepts any non-empty credentials. The endpoint is localhost because
# Streamlit runs on the host, not inside the Compose network.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL_S3=http://localhost:4566
# Host port and bind address for the Floci container. Floci accepts any
# credential and does not verify signatures, so it is published on loopback
# only; set FLOCI_BIND_HOST=0.0.0.0 only on a network you trust.
FLOCI_PORT=4566
FLOCI_BIND_HOST=127.0.0.1

# Ray Configuration
DASHBOARD_PORT=8265
HEAD_NODE_PORT=10001
PORT=6379
# Worker group size for the Kind topology. These have to fit inside the
# container VM alongside the head — see helm/ray-cluster-values.yaml.
NUM_CPU_WORKERS=2
NUM_CPUS_PER_WORKER=2
METRICS_EXPORT_PORT=8080
RAY_ADDRESS=ray://127.0.0.1:10001

# Multi-machine Ray (docs/multi-machine.md). Used only by the native
# head/worker scripts; the Kind topology ignores these.
# RAY_HEAD_ADDRESS is the head's LAN address, set on each worker machine.
RAY_HEAD_ADDRESS=
RAY_HEAD_PORT=6379
RAY_NODE_MANAGER_PORT=6380
RAY_OBJECT_MANAGER_PORT=6381
RAY_MIN_WORKER_PORT=11000
RAY_MAX_WORKER_PORT=11999

# Streamlit Configuration
STREAMLIT_PORT=8501

# KubeRay Configuration
KUBERAY_NAMESPACE=default
KUBERAY_CLUSTER_NAME=raycluster-kuberay
KIND_CLUSTER_NAME=kind
KIND_NODE_IMAGE=kindest/node:v1.35.0

# Development Options
DEBUG=false
LOG_LEVEL=INFO
